NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Envío de facturas por correo (nodemailer, buzón info@aibetech.es en Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@aibetech.es
SMTP_PASSWORD=

# Guardar copia del correo enviado en la carpeta "Enviados" (INBOX.Sent) vía IMAP.
# Opcionales: si no se indican, se usan estos valores por defecto de Hostinger y
# el mismo usuario/contraseña que el SMTP de arriba.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
